# Copy to backend/.env (or the repo root .env) and adjust. Never commit the real file.

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated origins allowed to call the API from a browser (only needed when the
# frontend is hosted on a different origin than the API).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to false only when TLS is terminated somewhere that does not send X-Forwarded-Proto.
DJANGO_SECURE_SSL_REDIRECT=true
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ----------------------------------------------------
# If unset, a local SQLite file is used (handy for tests only).
DATABASE_URL=postgres://haulwise:haulwise@localhost:5432/haulwise

# --- External providers (no API keys required by default) ------------------
# Routing: Valhalla with truck costing. The public FOSSGIS instance is free but rate-limited
# and intended for light use; point this at your own Valhalla or a hosted provider for scale.
VALHALLA_URL=https://valhalla1.openstreetmap.de
VALHALLA_API_KEY=
# Weather: Open-Meteo (free for non-commercial use). Commercial plans: set the customer URL + key.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
# Geocoding: Photon (autocomplete) with Nominatim fallback.
PHOTON_URL=https://photon.komoot.io/api/
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Identify your deployment to OSM-run services (their usage policy asks for this).
HTTP_USER_AGENT=haulwise/1.0 (contact: you@example.com)

# --- Tuning -----------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=45
ROUTING_TIMEOUT_SECONDS=90
TRUCK_TARE_LB=32000
WEATHER_CACHE_TTL_SECONDS=1800
WEATHER_GRID_DEGREES=0.05
WEATHER_BATCH_SIZE=50
API_THROTTLE_RATE=1000/hour
